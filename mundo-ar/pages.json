  "scene": "A21_ideas",
  "image": "image28.png",
  "lines": [
   "Tengo las ideas.",
   "Tengo las manos.",
   "Me falta la parte del medio.",
   "Esperé años una señal. No llega.",
   "Así que la pongo.",
   "Fea, incompleta, sin saber. La pongo."
  ],
  "aspect": 1.3006,
  "target": "t21.jpg"
