  "image": "image27.png",
  "lines": [
   "San Juan es donde vivo",
   "y donde me pienso morir.",
   "Pero mi lugar en el mundo",
   "es la orilla."
  ],
  "aspect": 1.3006,
  "target": "t20.jpg"
 },
 {
