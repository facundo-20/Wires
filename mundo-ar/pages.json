  "lines": [
   "Hablé al viento",
   "y el viento contestó.",
   "Papá y mamá siempre van a estar.",
   "Aunque no me veas.",
   "Sobre todo cuando no me veas."
  ],
  "aspect": 1.3006,
  "target": "t19.jpg"
 },
 {
